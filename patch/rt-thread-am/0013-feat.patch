diff --git a/bsp/abstract-machine/linker_flash_psram.ld b/bsp/abstract-machine/linker_flash_psram.ld
new file mode 100644
index 0000000..8843822
--- /dev/null
+++ b/bsp/abstract-machine/linker_flash_psram.ld
@@ -0,0 +1,126 @@
+MEMORY {
+    FLASH   (rx)  : ORIGIN = 0x30000000, LENGTH = 16M
+    MROM    (rx)  : ORIGIN = 0x20000000, LENGTH = 4096
+    SRAM    (xrw) : ORIGIN = 0x0f000000, LENGTH = 8K
+    PSRAM   (xrw) : ORIGIN = 0x80000000, LENGTH = 4M
+}
+
+/* 定义主内存区域，便于RT-Thread等操作系统初始化堆 */
+_pmem_start = ORIGIN(PSRAM);
+_pmem_size = LENGTH(PSRAM);
+_pmem_end = _pmem_start + _pmem_size;
+
+#define DEF_LOC >PSRAM AT>FLASH
+
+/* 定义堆栈大小 */
+_STACK_SIZE = 0x1000;    /* 4KB栈 */
+_HEAP_SIZE = 0x1000;     /* 4KB堆 */
+
+ENTRY(_start)
+/* PHDRS { text PT_LOAD; data PT_LOAD; } */
+
+SECTIONS {
+    /* -------- 直接从FLASH启动 -------- */
+    .bootloader : {
+        _bin_start = ALIGN(4);
+        KEEP(*(.bin_header))
+        *(entry)
+    } >FLASH
+    _bin_flag = _bin_start + 4;
+
+    /* -------- 程序和数据存放在FLASH，需要加载到RAM后跳转执行 -------- */
+    .text : {
+        _text_start = ALIGN(4);
+        *(.text)
+        *(.text*)
+        *(.rodata)
+        *(.rodata*)
+        *(.srodata)
+        *(.srodata*)
+        _text_end = ALIGN(4);
+    } >PSRAM AT>FLASH
+    etext = .;
+    _etext = .;
+    _text_load = LOADADDR(.text);
+
+    /* .data : {
+        *(.data)
+    } >PSRAM AT>FLASH */
+    /* .data 的加载地址紧跟 .text，VMA 在 PSRAM */
+    /* .data : AT(_text_end) { */
+    .data : {
+        _data_start = ALIGN(4);
+
+        /* RT-Thread扩展部分 */
+        /* section information for finsh shell */
+        __fsymtab_start = .;
+        KEEP(*(FSymTab))
+        __fsymtab_end = .;
+        . = ALIGN(8);
+        __vsymtab_start = .;
+        KEEP(*(VSymTab))
+        __vsymtab_end = .;
+        . = ALIGN(8);
+
+        /* section information for initial. */
+        . = ALIGN(8);
+        __rt_init_start = .;
+        KEEP(*(SORT(.rti_fn*)))
+        __rt_init_end = .;
+        . = ALIGN(8);
+
+        __rt_utest_tc_tab_start = .;
+        KEEP(*(UtestTcTab))
+        __rt_utest_tc_tab_end = .;
+
+        . = ALIGN(8);
+        __am_apps_data_start = .;
+        *(__am_apps.data*)
+        *(__am_apps.sdata*)
+        __am_apps_data_end = .;
+        . = ALIGN(8);
+
+        *(.data)
+        *(.data*)
+        *(.sdata)
+        *(.sdata*)
+        _data_end = ALIGN(4);
+    } >PSRAM AT>FLASH
+    edata = .;
+    _data = .;
+    _data_load = LOADADDR(.data);  /* 在存储器中的地址 */
+    _data_size = _data_end - _data_start;
+
+    .bss : {
+        _bss_start = ALIGN(4);
+
+        /* RT-Thread扩展部分 */
+        . = ALIGN(8);
+        __am_apps_bss_start = .;
+        *(__am_apps.bss*)
+        *(__am_apps.sbss*)
+        *(__am_apps.scommon*)
+        __am_apps_bss_end = .;
+        . = ALIGN(8);
+
+        *(.bss*)
+        *(.sbss*)
+        *(.scommon)        
+        _bss_end = ALIGN(4);
+    } >PSRAM
+    _bss_size = _bss_end - _bss_start;
+
+    /* 用户栈段 */
+    ._user_stack : {
+        /* _stack_top = ALIGN(0x1000); */
+        _stack_top = ALIGN(16);
+        . = _stack_top + _STACK_SIZE;
+        _stack_pointer = .;
+    } >SRAM
+
+    /* 用户堆段 */
+    ._user_heap : {
+        /* _heap_start = ALIGN(0x1000); */
+        _heap_start = ALIGN(16);
+    } >PSRAM
+}
diff --git a/bsp/abstract-machine/src/init.c b/bsp/abstract-machine/src/init.c
index 93e2711..25265ab 100644
--- a/bsp/abstract-machine/src/init.c
+++ b/bsp/abstract-machine/src/init.c
@@ -16,17 +16,21 @@ void rt_hw_board_init() {
 
 #ifdef RT_USING_HEAP
   /* initialize memory system */
+  printf("rt system heap: [%#x - %#x)\n", RT_HW_HEAP_BEGIN, RT_HW_HEAP_END);
   rt_system_heap_init(RT_HW_HEAP_BEGIN, RT_HW_HEAP_END);
 #endif
 
   uint32_t size = AM_APPS_HEAP_SIZE;
   void *p = NULL;
   for (; p == NULL && size != 0; size /= 2) { p = rt_malloc(size); }
+  printf("rt apps heap: [%#x - %#x)\n", p, p + size);
   am_apps_heap = RANGE(p, p + size);
 
   extern char __am_apps_data_start, __am_apps_data_end;
   extern char __am_apps_bss_start, __am_apps_bss_end;
+  printf("rt apps data: [%#x - %#x)\n", &__am_apps_data_start, &__am_apps_data_end);
   am_apps_data = RANGE(&__am_apps_data_start, &__am_apps_data_end);
+  printf("rt apps bss: [%#x - %#x)\n", &__am_apps_bss_start, &__am_apps_bss_end);
   am_apps_bss  = RANGE(&__am_apps_bss_start,  &__am_apps_bss_end);
   printf("am-apps.data.size = %ld, am-apps.bss.size = %ld\n",
       am_apps_data.end - am_apps_data.start, am_apps_bss.end - am_apps_bss.start);
@@ -47,9 +51,9 @@ void rt_hw_board_init() {
   rt_components_board_init();
 #endif
 
-#ifdef RT_USING_HEAP
-  rt_kprintf("heap: [0x%08x - 0x%08x]\n", (rt_ubase_t) RT_HW_HEAP_BEGIN, (rt_ubase_t) RT_HW_HEAP_END);
-#endif
+// #ifdef RT_USING_HEAP
+//   rt_kprintf("heap: [0x%08x - 0x%08x]\n", (rt_ubase_t) RT_HW_HEAP_BEGIN, (rt_ubase_t) RT_HW_HEAP_END);
+// #endif
 }
 
 int main() {
