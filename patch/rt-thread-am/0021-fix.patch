---
 bsp/abstract-machine/linker_flash_psram.ld      | 5 ++++-
 bsp/abstract-machine/linker_flash_sram_sdram.ld | 5 ++++-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/bsp/abstract-machine/linker_flash_psram.ld b/bsp/abstract-machine/linker_flash_psram.ld
index 86e377b..979ca1b 100644
--- a/bsp/abstract-machine/linker_flash_psram.ld
+++ b/bsp/abstract-machine/linker_flash_psram.ld
@@ -37,7 +37,8 @@ SECTIONS {
         *(.rodata*)
         *(.srodata)
         *(.srodata*)
-        _text_end = ALIGN(4);
+        . = ALIGN(4);
+        _text_end = .;
     } >PSRAM AT>FLASH
     etext = .;
     _etext = .;
@@ -90,6 +91,8 @@ SECTIONS {
     _data = .;
     _data_load = LOADADDR(.data);  /* 在存储器中的地址 */
     _data_size = _data_end - _data_start;
+    ASSERT((_text_load & 3) == 0, "text load address must be 4-byte aligned")
+    ASSERT((_data_load & 3) == 0, "data load address must be 4-byte aligned")
 
     .bss : {
         _bss_start = ALIGN(4);
diff --git a/bsp/abstract-machine/linker_flash_sram_sdram.ld b/bsp/abstract-machine/linker_flash_sram_sdram.ld
index 8922943..59f3498 100644
--- a/bsp/abstract-machine/linker_flash_sram_sdram.ld
+++ b/bsp/abstract-machine/linker_flash_sram_sdram.ld
@@ -50,7 +50,8 @@ SECTIONS {
         *(.rodata*)
         *(.srodata)
         *(.srodata*)
-        _text_end = ALIGN(4);
+        . = ALIGN(4);
+        _text_end = .;
     } >SDRAM AT>FLASH
     etext = .;
     _etext = .;
@@ -103,6 +104,8 @@ SECTIONS {
     _data = .;
     _data_load = LOADADDR(.data);  /* 在存储器中的地址 */
     _data_size = _data_end - _data_start;
+    ASSERT((_text_load & 3) == 0, "text load address must be 4-byte aligned")
+    ASSERT((_data_load & 3) == 0, "data load address must be 4-byte aligned")
 
     .bss : {
         _bss_start = ALIGN(4);
-- 
