+    wire [7:0] read_done_count = (cas_latency + 2 * (read_index_max - 1));
+    wire read_done = (state==read_t) && (counter == read_done_count);
+    wire [31:0] roffset = {30'h0, dqm};
+    integer new_rdata;
+
+    initial begin
+        state = idle_t;
+        counter = 0;
+        addr = 0;
+        rdata = 0;
+        wmask = 0;
