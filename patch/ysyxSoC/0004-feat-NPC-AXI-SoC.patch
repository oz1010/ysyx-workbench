+                        xip_state <= XIP_INIT_TX0;
+                    end
+                end
+
+                XIP_INIT_TX0: begin
+                    if (!xip_in_penable) begin
+                        xip_in_paddr <= 5'h00;
+                        xip_in_pwdata <= 32'h0;
+                        xip_in_pstrb <= 4'hf;
+                        xip_in_pwrite <= 1;
+                        xip_in_penable <= 1;
+                    end
+                    if (u0_in_pready && xip_in_penable) begin
+                        xip_in_penable <= 0;
+                        xip_state <= XIP_INIT_TX1;
+                    end
+                end
+
+                XIP_INIT_TX1: begin
+                    if (!xip_in_penable) begin
+                        xip_in_paddr <= 5'h04;
+                        // 4字节对齐访问
+                        xip_in_pwdata <= {8'h03, in_paddr[23:2], 2'h0};
+                        // xip_in_pwdata <= {8'h03, in_paddr[23:0]};
+                        xip_in_pstrb <= 4'hf;
+                        xip_in_pwrite <= 1;
+                        xip_in_penable <= 1;
+                    end
+                    if (u0_in_pready && xip_in_penable) begin
+                        xip_in_penable <= 0;
+                        xip_state <= XIP_INIT_CTRL;
+                    end
+                end
+
+                XIP_INIT_CTRL: begin
+                    if (!xip_in_penable) begin
+                        xip_in_paddr <= 5'h10;
+                        xip_in_pwdata <= 32'h2540;
+                        xip_in_pstrb <= 4'hf;
+                        xip_in_pwrite <= 1;
+                        xip_in_penable <= 1;
+                    end
+                    if (u0_in_pready && xip_in_penable) begin
+                        xip_in_penable <= 0;
+                        xip_state <= XIP_WAIT_TRANSFER;
+                    end
+                end
+
+                XIP_WAIT_TRANSFER: begin
+                    if (!xip_in_penable) begin
+                        xip_in_paddr <= 5'h10;
+                        xip_in_pwdata <= 32'h0;
+                        xip_in_pstrb <= 4'hf;
+                        xip_in_pwrite <= 0;
+                        xip_in_penable <= 1;
+                    end
+                    if (u0_in_pready && xip_in_penable) begin
+                        xip_in_penable <= 0;
+                        if (!u0_in_prdata[8]) xip_state <= XIP_READ_DATA;
+                    end
+                end
+
+                XIP_READ_DATA: begin
+                    if (!xip_in_penable) begin
+                        xip_in_paddr <= 5'h0;
+                        xip_in_pwdata <= 32'h0;
+                        xip_in_pstrb <= in_pstrb;
+                        xip_in_pwrite <= 0;
+                        xip_in_penable <= 1;
+                    end
+                    if (u0_in_pready && xip_in_penable) begin
+                        // 0x30313233
+                        xip_in_prdata <= {u0_in_prdata[7:0], u0_in_prdata[15:8], u0_in_prdata[23:16], u0_in_prdata[31:24]};
+                        // xip_in_prdata <= u0_in_prdata;
+                        xip_in_pready <= 1;
+
+                        xip_in_penable <= 0;
+                        xip_state <= XIP_READ_DONE;
+                        xip_in_psel <= 0;
+                    end
+                end
+
+                XIP_READ_DONE: begin
+                    xip_state <= XIP_IDLE;
+                    xip_in_pready <= 0;
+                end
+
+                default: $error("Found unknown state %d", xip_state);
+            endcase
+        end else begin
+            xip_in_psel <= 0;
+            xip_in_penable <= 0;
+            xip_state <= XIP_IDLE;
+            xip_in_pready <= 0;
+        end
+    end
+end
