+assign in_pready = is_xip ? xip_in_pready : u0_in_pready;
+assign in_prdata = is_xip ? xip_in_prdata : u0_in_prdata;
+
+typedef enum[3:0] {
+    XIP_IDLE,
+    XIP_INIT_DIVIDER,
+    XIP_INIT_SS,
+    XIP_INIT_TX0,
+    XIP_INIT_TX1,
+    XIP_INIT_CTRL,
+    XIP_WAIT_TRANSFER,
+    XIP_READ_DATA,
+    XIP_READ_DONE
