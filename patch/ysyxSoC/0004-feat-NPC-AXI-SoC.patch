+// Using 35H Command
+module PSRAM_SWITCHER (
+    input   wire            clock,
+    input   wire            rst_n,
+    input   wire            sw,
+    output  wire            done,
+
+    output  reg             sck,
+    output  reg             ce_n,
+    input   wire [3:0]      din,
+    output  wire [3:0]      dout,
+    output  wire            douten
+);
+
+localparam  IDLE = 1'b0,
+            SWITCH = 1'b1;
+
+reg         state, nstate;
+reg [7:0]   counter;
+
+wire[7:0]   CMD_35H = 8'h35;
+
+always @*
+    case(state)
+        IDLE: if(sw) nstate = SWITCH; else nstate = IDLE;
+        SWITCH: if(done) nstate = IDLE; else nstate = SWITCH;
+    endcase
+
+always @(posedge clock or negedge rst_n)
+    if(!rst_n) state <= IDLE;
+    else state <= nstate;
+
+// Drive the Serial Clock (sck) @ clock/2
+always @(posedge clock or negedge rst_n)
+    if(!rst_n) sck <= 0;
+    else if(~ce_n) sck <= ~ sck;
+    else if(state == IDLE) sck <= 0;
+
+// ce_n logic
+always @(posedge clock or negedge rst_n)
+    if(!rst_n) ce_n <= 1;
+    else if(state == SWITCH) ce_n <= 0;
+    else ce_n <= 1;
+
+always @(posedge clock or negedge rst_n)
+    if(!rst_n) counter <= 0;
+    else if(sck & ~done) counter <= counter + 1;
+    else if(state == IDLE) counter <= 0;
+
+assign dout     =   (counter < 8)   ?   {3'b0, CMD_35H[7 - counter]}    :
+                    0;
+assign douten   = (~ce_n);
+assign done     = (counter == 8);
+
+endmodule
