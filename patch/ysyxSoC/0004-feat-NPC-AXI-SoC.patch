+reg [3:0] xip_state;
+
+always @(posedge clock) begin
+    if (reset) begin
+        xip_state <= XIP_IDLE;
+    end else begin
+        if (is_xip) begin
+            case (xip_state)
+                XIP_IDLE: begin
+                    xip_in_psel <= 1;
+                    xip_in_penable <= 0;
+                    xip_state <= XIP_INIT_DIVIDER;
+                    // if (in_paddr[1:0]>0) $error("Only support align addr access to flash %x", in_paddr);
+                end
+
+                XIP_INIT_DIVIDER: begin
+                    if (!xip_in_penable) begin
+                        xip_in_paddr <= 5'h14;
+                        xip_in_pwdata <= 0;
+                        xip_in_pstrb <= 4'h3;
+                        xip_in_pwrite <= 1;
+                        xip_in_penable <= 1;
+                    end
+                    if (u0_in_pready && xip_in_penable) begin
+                        xip_in_penable <= 0;
+                        xip_state <= XIP_INIT_SS;
+                    end
+                end
+
+                XIP_INIT_SS: begin
+                    if (!xip_in_penable) begin
