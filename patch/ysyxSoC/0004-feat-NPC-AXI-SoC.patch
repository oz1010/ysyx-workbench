+module sdram_array(
+  input         clk,
+  input         cke,
+  input         cs,
+  input         ras,
+  input         cas,
+  input         we,
+  input  [12:0] a,
+  input  [ 1:0] ba,
+  input  [ 3:0] dqm,
+  input  [ 1:0] bsel,
+  inout  [31:0] dq
+);
+
+  generate
+    genvar block, half;
+    for (block = 0; block < 2; block = block + 1) begin : block_gen
+      for (half = 0; half < 2; half = half + 1) begin : half_gen
+        sdram #(
+          .BASE_ADDR_OFFSET(block * 32'h02000000 + half * 2)
+        ) sdram (
+          .clk  (clk),
+          .cke  (cke),
+          .cs   (cs),
+          .ras  (ras),
+          .cas  (cas),
+          .we   (we),
+          .a    (a),
+          .ba   (ba),
+          .dqm  (dqm[2 * half + 1:2 * half]),
+          .bsel (bsel[block]),
+          .dq   (dq[16 * half + 15:16 * half])
+        );
+      end
+    end
+  endgenerate
+
+endmodule
