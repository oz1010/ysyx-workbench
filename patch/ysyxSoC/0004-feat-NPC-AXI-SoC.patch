   assign in_rresp = out_rresp;
diff --git a/perip/amba/delayer.v b/perip/amba/delayer.v
new file mode 100644
index 0000000..7c93b4f
--- /dev/null
+++ b/perip/amba/delayer.v
@@ -0,0 +1,92 @@
+/*
+ * 信号延时模块，将in_signal的触发信号，等待一定周期后，再通过out_signal释放一个类似的触发信号。触发延时需要满足两个条件
+ *   - start 信号开启延时
+ *   - delta 延时量不为零
+ * 当start信号触发，delay_cycle不断累积变化量
+ * 当catch信号触发，delay_cycle不断进行递减。直到delay_cycle为0时释放out_signal触发信号
+ */
+module delayer #(
+    `ifndef IN_YOSYS_STA
+    parameter NAME,
+    `endif
+    parameter SIGNAL_WIDTH = 1,
+    parameter SKIP_DELAY_EN = 0,
+    parameter K_BITS = 8 // 延时放大系数，对应移位项
+) (
+    input               clock,
+    input               reset,
+    input               enable,
+    input               start,
+    input               catch,
+    input [31:0]        delta,
+    input [SIGNAL_WIDTH-1:0]    in_signal,
+    output [SIGNAL_WIDTH-1:0]   out_signal
+);
+
+    enum [2:0] { idle_t, delay_t, delay_wait_t, err_t } state_t;
+
+    reg [31:0] delay_cycle;
+    reg [2:0] delay_state;
+    reg delay_signal;
+    reg last_start, last_catch;
+
+    assign out_signal   = {SIGNAL_WIDTH{delay_signal}};
+
+    // 转换为触发信号，类似捕捉上升沿
+    always @(posedge clock) begin
+        last_start <= start;
+        last_catch <= catch;
+    end
+    wire start_trigger = enable && start && !last_start;
+    wire catch_trigger = enable && catch && !last_catch;
+
+    always @(posedge clock or posedge reset) begin
+        if (reset || !enable) begin
+            delay_cycle <= 0;
+            delay_signal <= 0;
+            delay_state <= idle_t;
+        end else begin
+            case (delay_state)
+                idle_t: begin
+                    if (start_trigger && delta!=0) begin
+                        delay_state <= delay_t;
+                        delay_cycle <= delta; // 需要记录第一个周期
+                        // 启动时直接捕获触发信号
+                        if (catch_trigger && SKIP_DELAY_EN) begin
+                            delay_state <= delay_wait_t;
+                            delay_cycle <= (delta >> K_BITS);
+                        end
+                    end
+                end
+
+                delay_t: begin
+                    delay_cycle <= delay_cycle + delta;
+                    if (catch_trigger) begin
+                        delay_state <= delay_wait_t;
+                        delay_cycle <= (delay_cycle >> K_BITS);
+                    end
+                end
+
+                delay_wait_t: begin
+                    delay_cycle <= delay_cycle - 1;
+                    if (delay_cycle == 0) begin
+                        delay_signal <= 1;
+                        delay_cycle <= 0;
+                    end
+                end
+
+                default: begin
+                    `ifndef IN_YOSYS_STA
+                    $error("unknown delay_state %x in %s", delay_state, NAME);
+                    `endif
+                end
+            endcase
+
+            if (delay_signal) begin
+                delay_signal <= 0;
+                delay_state <= idle_t;
+            end
+        end
+    end
+
+endmodule
diff --git a/perip/bitrev/bitrev.v b/perip/bitrev/bitrev.v
index f1c3b36..8ab053c 100644
--- a/perip/bitrev/bitrev.v
+++ b/perip/bitrev/bitrev.v
@@ -4,5 +4,58 @@ module bitrev (
   input  mosi,
   output miso
 );
-  assign miso = 1'b1;
+
+typedef enum[1:0] {
+    BITREV_IN,
+    BITREV_OUT,
+    BITREV_WAIT
+} bitrev_state_t;
+
+reg [7:0] bits;
+reg [2:0] cnt;
+reg [1:0] state;
+reg out_bit;
+
+assign miso = out_bit;
+
+always @(posedge sck or posedge ss) begin
+    if (ss) begin
+        bits <= 0;
+        cnt <= 0;
+        state <= BITREV_IN;
+        out_bit <= 1;
+    end else begin
+        case (state)
+            BITREV_IN: begin
+                cnt <= cnt + 1;
+                bits[cnt] <= mosi;
+
+                if (cnt == 7) begin
+                    state <= BITREV_OUT;
+                    out_bit <= mosi;
+                    cnt <= cnt -1;
+                end
+            end
+
+            BITREV_OUT: begin
+                cnt <= cnt - 1;
+                out_bit <= bits[cnt];
+
+                if (cnt == 0) begin
+                    bits <= 0;
+                    cnt <= 0;
+                    state <= BITREV_WAIT;
+                end
+            end
+
+            default: begin
+                bits <= 0;
+                cnt <= 0;
+                state <= state;
+                out_bit <= 1;
+            end
+        endcase
+    end
+end
+
 endmodule
diff --git a/perip/gpio/gpio_led.v b/perip/gpio/gpio_led.v
new file mode 100644
index 0000000..bee7674
--- /dev/null
+++ b/perip/gpio/gpio_led.v
@@ -0,0 +1,42 @@
+module gpio_led #(
+    parameter LED_BITS = 16
+) (
+    input                   clock,
+    input                   reset,
+    input                   ce_n,
+    input                   we_n,
+    input  [LED_BITS-1:0]   wdata,
+
+    output                  ack_o,
+    output [LED_BITS-1:0]   led_value_o
+);
+
+reg [LED_BITS-1:0]  led_value;
+reg update_ack;
+
+wire update_en = !ce_n && !we_n;
+
+assign led_value_o = led_value;
+assign ack_o = update_ack;
+
+initial begin
+    led_value = {LED_BITS{1'b0}};
+    update_ack = 0;
+end
+
+always @(posedge clock or posedge reset) begin
+    if (reset) begin
+        led_value <= 0;
+        update_ack <= 0;
+    end else begin
+        if (update_en && !update_ack) begin
+            led_value <= wdata;
+            // $display("led value update to %x", wdata);
+            update_ack <= 1;
+        end else begin
+            update_ack <= 0;
+        end
+    end
+end
+
+endmodule
