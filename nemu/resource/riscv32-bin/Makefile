TOOLCHAIN	:=	riscv64-linux-gnu-
CC			:=	${TOOLCHAIN}gcc
OBJDUMP		:=	${TOOLCHAIN}objdump
OBJCOPY		:=	${TOOLCHAIN}objcopy
BUILD_DIR	?=	$(NEMU_HOME)/build/riscv32-bin

TAGET		:= $(BUILD_DIR)/prog
BINARY		:= ${TAGET}.bin
OBJ_TARGET  := ${TAGET}.hex
MEM_TARGET  := ${TAGET}.mem

# Include variables and rules generated by menuconfig
-include $(NPC_HOME)/include/config/auto.conf

# Generate bin with flag
BINARY_FLG	:= -O binary
BINARY_FLG	+= -S
BINARY_FLG	+= -j .text -j .data -j .rodata -j .init -j .fini -j .vectors -j .isr_vector

all: ${BINARY} ${OBJ_TARGET}

# ${CC} -ffreestanding -nostdlib -static -Wl,-Ttext=0 -O2 -o $@ $<
${TAGET}: a.c
	@mkdir -p $(dir $@)
	${CC} -march=rv32i -mabi=ilp32 -ffreestanding -nostdlib -static -Wl,-Ttext=${CONFIG_MBASE} -O2 -g -o $@ $<

# ${OBJDUMP} -M no-aliases -d $<
${OBJ_TARGET}: ${TAGET}
	@${OBJDUMP} -M no-aliases -d $< >$@

# riscv64-linux-gnu-objcopy -O binary -S -j .text -j .data build/bin/prog prog.bin
${BINARY}: ${TAGET}
	@${OBJCOPY} ${BINARY_FLG} $^ $@

${MEM_TARGET}: ${BINARY}
	@hexdump -v -e '4/1 "%02x" "\n"' $^ >$@

clean:
	@-rm -f ${TAGET} ${BINARY}

.PHONY: clean
