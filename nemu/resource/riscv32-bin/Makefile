PRO_PATH		:= $(NEMU_HOME)
COMFLAGS		:=
DEFINES			:=
INC_FILES		:=
ASFLAGS			:=
CFLAGS			:= -I$(AM_HOME)/am/src/platform/nemu/include 
LDFLAGS			:=
# DEFINES		+=-D__ARCH__=riscv32e-nemu
# DEFINES		+=-D__ARCH_RISCV32E_NEMU
# DEFINES		+=-D__PLATFORM__=nemu
# DEFINES		+=-D__PLATFORM_NEMU

CROSS_COMPILE	:= riscv64-linux-gnu-
AS        		:= $(CROSS_COMPILE)gcc
CC				:= $(CROSS_COMPILE)gcc
CXX       		:= $(CROSS_COMPILE)g++
LD        		:= $(CROSS_COMPILE)ld
AR        		:= $(CROSS_COMPILE)ar
OBJDUMP			:= $(CROSS_COMPILE)objdump
OBJCOPY			:= $(CROSS_COMPILE)objcopy
BUILD_DIR		?= $(PRO_PATH)/build/riscv32-bin

TAGET			:= $(BUILD_DIR)/prog.elf
BINARY			:= $(addsuffix .bin, $(basename $(TAGET)))
OBJ_TARGET  	:= $(addsuffix .txt, $(basename $(TAGET)))
MEM_TARGET  	:= $(addsuffix .mem, $(basename $(TAGET)))

# Include variables and rules generated by menuconfig
-include $(PRO_PATH)/include/config/auto.conf

# Generate bin with flag
BINARY_FLG	:= -O binary
BINARY_FLG	+= -S
# # 指定contents属性会使.bss保留内容0，造成生成文件过大。适合加载bin文件后不初始化.bss的场景
# BINARY_FLG	+= --set-section-flags .bss=alloc,contents
# # 只复制特定段到bin中
# BINARY_FLG     += -j .data.extra -j .bss.extra -j .bootloader -j .bin_header -j .text -j .data -j .rodata -j .init -j .fini -j .vectors -j .isr_vector

SRCS		:=
SRCS		+= start.S
SRCS		+= init.c

INC_FILES   += $(AM_HOME)/../common/include
# INC_FILES   += $(AM_HOME)/am/src
INC_FILES   += $(AM_HOME)/am/include
# INC_FILES   += $(AM_HOME)/klib/include

# DEFINES		+=-D__GUEST_ISA__=riscv32e
# DEFINES		+=-D__ISA__="riscv32e"
# DEFINES		+=-D__ISA_RISCV32E__
# DEFINES		+=-DARCH_H="arch/riscv.h"

# COMFLAGS	+= -O0 -g
COMFLAGS	+= -O2

OBJS		= $(addprefix $(BUILD_DIR)/, $(addsuffix .o, $(basename $(SRCS))))
INCS 		= $(addprefix -I, $(INC_FILES))


# GCC 13.3.0 中 fence.i 需显式声明 zifencei 扩展, 旧版本不支持该写法
ifeq ($(shell $(CC) -dumpfullversion),13.3.0)
RISCV_MARCH	:= rv32em_zicsr_zifencei
else
RISCV_MARCH	:= rv32em_zicsr
endif

ASFLAGS		+= $(COMFLAGS) -MMD $(INCS) -fno-pic -mcmodel=medany -mstrict-align -march=$(RISCV_MARCH) -mabi=ilp32e

CFLAGS		+= $(COMFLAGS) -MMD -Wall -Werror $(INCS) $(DEFINES) -fno-asynchronous-unwind-tables -fno-builtin -fno-stack-protector -Wno-main -U_FORTIFY_SOURCE -fvisibility=hidden -fno-pic -mcmodel=medany -mstrict-align -march=$(RISCV_MARCH) -mabi=ilp32e -static -fdata-sections -ffunction-sections -DMAINARGS="" -DISA_H="riscv/riscv.h"

LDFLAGS		+= -z noexecstack -melf32lriscv -T $(AM_HOME)/scripts/platform/nemu/linker_flash_sram.ld --defsym=_pmem_start=0x20000000 --defsym=_entry_offset=0x0 --gc-sections

all: ${BINARY} ${OBJ_TARGET}

$(BUILD_DIR)/%.o: %.S
	@mkdir -p $(dir $@) && echo + AS $<
	@$(AS) $(ASFLAGS) -c -o $@ $(realpath $<)

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@) && echo + CC $<
	@$(CC) -std=gnu11 $(CFLAGS) -c -o $@ $(realpath $<)

# ${CC} -ffreestanding -nostdlib -static -Wl,-Ttext=0 -O2 -o $@ $<
# ${TAGET}: a.c
# 	@mkdir -p $(dir $@)
# 	${CC} -march=rv32i -mabi=ilp32 -ffreestanding -nostdlib -static -T $(AM_HOME)/scripts/platform/nemu/linker_flash_sram.ld -Wl,-Ttext=${CONFIG_MBASE} -O0 -g -o $@ $<
${TAGET}: $(OBJS)
	@mkdir -p $(dir $@) && echo + LD "->" $@
	@$(LD) $(LDFLAGS) -o $@ $^

# ${OBJDUMP} -M no-aliases -d $<
${OBJ_TARGET}: ${TAGET}
	@${OBJDUMP} -M no-aliases -d $< >$@

# riscv64-linux-gnu-objcopy -O binary -S -j .text -j .data build/bin/prog prog.bin
${BINARY}: ${TAGET}
	@${OBJCOPY} ${BINARY_FLG} $^ $@

${MEM_TARGET}: ${BINARY}
	@hexdump -v -e '4/1 "%02x" "\n"' $^ >$@

clean:
	@-rm -rf $(BUILD_DIR)

.PHONY: clean

