CROSS_COMPILE	:= riscv64-linux-gnu-
AS        		:= $(CROSS_COMPILE)gcc
CC				:= $(CROSS_COMPILE)gcc
CXX       		:= $(CROSS_COMPILE)g++
LD        		:= $(CROSS_COMPILE)ld
AR        		:= $(CROSS_COMPILE)ar
OBJDUMP			:= $(CROSS_COMPILE)objdump
OBJCOPY			:= $(CROSS_COMPILE)objcopy
BUILD_DIR		?= $(NPC_HOME)/build/riscv32-bin

TAGET			:= $(BUILD_DIR)/prog.elf
BINARY			:= $(addsuffix .bin, $(basename $(TAGET)))
OBJ_TARGET  	:= $(addsuffix .hex, $(basename $(TAGET)))
MEM_TARGET  	:= $(addsuffix .mem, $(basename $(TAGET)))

# Include variables and rules generated by menuconfig
-include $(NPC_HOME)/include/config/auto.conf

# Generate bin with flag
BINARY_FLG	:= -O binary
BINARY_FLG	+= -S
BINARY_FLG	+= -j .text -j .data -j .rodata -j .init -j .fini -j .vectors -j .isr_vector

SRCS		:=
SRCS		+= start.S
SRCS		+= init.c

INC_FILES	:=
# INC_FILES   += $(AM_HOME)/am/src 
# INC_FILES   += $(AM_HOME)/am/include 
# INC_FILES   += $(AM_HOME)/am/include
# INC_FILES   += $(AM_HOME)/klib/include

DEFINES		:=
# DEFINES		+=-D__GUEST_ISA__=riscv32e
# DEFINES		+=-D__ISA__="riscv32e"
# DEFINES		+=-D__ISA_RISCV32E__
# DEFINES		+=-D__ARCH__=riscv32e-npc
# DEFINES		+=-D__ARCH_RISCV32E_NPC
# DEFINES		+=-D__PLATFORM__=npc
# DEFINES		+=-D__PLATFORM_NPC
# DEFINES		+=-DARCH_H="arch/riscv.h"

COMFLAGS	:=
# COMFLAGS	+= -O0 -g
COMFLAGS	+= -O2

OBJS		= $(addprefix $(BUILD_DIR)/, $(addsuffix .o, $(basename $(SRCS))))
INCS 		= $(addprefix -I, $(INC_FILES))

ASFLAGS		:=
ASFLAGS		+= $(COMFLAGS) -MMD $(INCS) -fno-pic -mcmodel=medany -mstrict-align -march=rv32em_zicsr -mabi=ilp32e

CFLAGS		:=
CFLAGS		+= $(COMFLAGS) -MMD -Wall -Werror $(INCS) $(DEFINES) -fno-asynchronous-unwind-tables -fno-builtin -fno-stack-protector -Wno-main -U_FORTIFY_SOURCE -fvisibility=hidden -fno-pic -mcmodel=medany -mstrict-align -march=rv32em_zicsr -mabi=ilp32e -static -fdata-sections -ffunction-sections -DMAINARGS="" -I$(AM_HOME)/am/src/platform/npc/include -DISA_H="riscv/riscv.h"

LDFLAGS		:=
LDFLAGS		+= -z noexecstack -melf32lriscv -T $(AM_HOME)/scripts/linker.ld --defsym=_pmem_start=0x20000000 --defsym=_entry_offset=0x0 --gc-sections -e _start

all: ${BINARY} ${OBJ_TARGET}

$(BUILD_DIR)/%.o: %.S
	@mkdir -p $(dir $@) && echo + AS $<
	@$(AS) $(ASFLAGS) -c -o $@ $(realpath $<)

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@) && echo + CC $<
	@$(CC) -std=gnu11 $(CFLAGS) -c -o $@ $(realpath $<)

# ${CC} -ffreestanding -nostdlib -static -Wl,-Ttext=0 -O2 -o $@ $<
# ${TAGET}: a.c
# 	@mkdir -p $(dir $@)
# 	${CC} -march=rv32i -mabi=ilp32 -ffreestanding -nostdlib -static -T $(AM_HOME)/scripts/linker.ld -Wl,-Ttext=${CONFIG_MBASE} -O0 -g -o $@ $<
${TAGET}: $(OBJS)
	@mkdir -p $(dir $@) && echo + LD "->" $@
	@$(LD) $(LDFLAGS) -o $@ $^

# ${OBJDUMP} -M no-aliases -d $<
${OBJ_TARGET}: ${TAGET}
	@${OBJDUMP} -M no-aliases -d $< >$@

# riscv64-linux-gnu-objcopy -O binary -S -j .text -j .data build/bin/prog prog.bin
${BINARY}: ${TAGET}
	@${OBJCOPY} ${BINARY_FLG} $^ $@

${MEM_TARGET}: ${BINARY}
	@hexdump -v -e '4/1 "%02x" "\n"' $^ >$@

clean:
	@-rm -rf $(BUILD_DIR)

.PHONY: clean
