PRO_PATH		:= $(NPC_HOME)
WORK_DIR    	= $(shell pwd)

BUILD_DIR		?= $(PRO_PATH)/build/verilog-test
BINARY			:= $(BUILD_DIR)/vcase
OBJ_DIR  		= $(BUILD_DIR)/obj-vcase
VGEN_DIR    	= $(BUILD_DIR)/vgen
# VMOD_NAME		= ysyxSoCFull
VMOD_NAME		= top
VERILATOR   	= verilator
GUEST_ISA		= riscv32

# Include variables and rules generated by menuconfig
-include $(PRO_PATH)/include/config/auto.conf

VSRCS-y += ./test/vsrc/core/top.v
# VSRCS-y += $(PRO_PATH)/../ysyxSoC/build/ysyxSoCFull.v
# VSRCS-y += ./vsrc/core/ysyx_23060295.v
# VDIRS-y									+= ./vsrc/core/common
# # VDIRS-y									+= ./vsrc/core
# VDIRS-y									+= ./vsrc/device
# VDIRS-$(CONFIG_ISA_RISCV_MULTIPLE)		+= ./vsrc/core/multiple
# VDIRS-$(CONFIG_ISA_RISCV_SINGLE)		+= ./vsrc/core/single
# VDIRS-y									+= $(PRO_PATH)/../ysyxSoC/perip/amba
# VDIRS-y									+= $(PRO_PATH)/../ysyxSoC/perip/bitrev
# VDIRS-y									+= $(PRO_PATH)/../ysyxSoC/perip/flash
# VDIRS-y									+= $(PRO_PATH)/../ysyxSoC/perip/gpio
# VDIRS-y									+= $(PRO_PATH)/../ysyxSoC/perip/ps2
# VDIRS-y									+= $(PRO_PATH)/../ysyxSoC/perip/psram
# VDIRS-y									+= $(PRO_PATH)/../ysyxSoC/perip/psram/efabless
# VDIRS-y									+= $(PRO_PATH)/../ysyxSoC/perip/sdram
# VDIRS-y									+= $(PRO_PATH)/../ysyxSoC/perip/sdram/core_sdram_axi4
# VDIRS-y									+= $(PRO_PATH)/../ysyxSoC/perip/spi
# VDIRS-y									+= $(PRO_PATH)/../ysyxSoC/perip/uart16550
# VDIRS-y									+= $(PRO_PATH)/../ysyxSoC/perip/vga
# # VSRCS-y		+= $(shell find -L $(PRO_PATH)/../ysyxSoC/perip -name *.v)

VCSR_CPPS   = $(shell find -L . -name "*.cpp")
VSRCS-y		+= $(shell find -L $(VDIRS-y) -maxdepth 1 -name *.v)
VSRCS       += $(addprefix $(PRO_PATH)/,$(VSRCS-y))
VSRCS     	+= $(addprefix $(WORK_DIR)/,$(VCSR_CPPS))
INC_PATH    += $(PRO_PATH)/include
INC_PATH    += $(PRO_PATH)/src/isa/$(GUEST_ISA)/include
INC_PATH    += $(PRO_PATH)/../common/include
INC_PATH    += $(PRO_PATH)/test/vsrc/core/cases
INC_PATH    += $(VGEN_DIR)
INC_PATH    += $(VDIRS-y)
INC_PATH    += $(PRO_PATH)/vsrc/core/common
INC_PATH    += $(PRO_PATH)/vsrc/core/multiple
INC_PATH    += $(PRO_PATH)/../ysyxSoC/perip/uart16550/rtl
INC_PATH    += $(PRO_PATH)/../ysyxSoC/perip/spi/rtl
LDFLAGS     += -L$(VGEN_DIR) -lV$(VMOD_NAME) -lverilated -lreadline  -pthread -lpthread -latomic

# TRACE=1 make run -j , code define VM_TRACE_VCD
ifdef TRACE
VERILATOR_CFLAGS += --trace
endif

# 多个目标会触发多次构建规则，这里选择其中一个即可
VOBJS = $(VGEN_DIR)/libV$(VMOD_NAME).a
# VOBJS += $(VGEN_DIR)/V$(VMOD_NAME)_ALL.a $(VGEN_DIR)/libV$(VMOD_NAME).a $(VGEN_DIR)/libverilated.a
ifeq ($(VSRCS),)
    $(error "verilator need *.v files to build")
endif
# # VCXXFLAGS += $(shell llvm-config --cxxflags) -fPIE
# VCXXFLAGS += -I/usr/lib/llvm-14/include -fno-exceptions -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_LIMIT_MACROS -fPIE
# VLDFLAGS += $(shell llvm-config --libs)
# VERILATOR_CFLAGS += -MMD --build -cc
# VERILATOR_CFLAGS += -O3 --x-assign fast --x-initial fast --noassert
VCXX_OPT += $(if $(CONFIG_CC_OPT),$(call remove_quote,$(CONFIG_CC_OPT)),-O0)
VCXXFLAGS += $(if $(CONFIG_CC_DEBUG),-O0 -ggdb3,$(VCXX_OPT))
VCXXFLAGS += $(addprefix -I,$(INC_PATH))
VCXXFLAGS += -DTOP_NAME="\"$(VMOD_NAME)\""
VCXXFLAGS += -DTOP_FILE=V$(VMOD_NAME).h
VCXXFLAGS += -D__GUEST_ISA__=$(GUEST_ISA)
VERILATOR_CFLAGS += -cc --build -j --top-module $(VMOD_NAME) --Mdir $(VGEN_DIR)
VERILATOR_CFLAGS += --timescale "1ns/1ns" --timing
# --no-timing
VERILATOR_CFLAGS += --autoflush
VERILATOR_CFLAGS += -y $(WORK_DIR)/vsrc/core

# Compilation flags
ifeq ($(CC),clang)
CXX := clang++
else
CXX := g++
endif
LD := $(CXX)
INCLUDES = $(addprefix -I, $(INC_PATH))
CFLAGS  := -O2 -MMD -Wall -Werror $(INCLUDES) $(CFLAGS)
LDFLAGS := -O2 $(LDFLAGS)

VERILATOR_CFLAGS += $(INCLUDES)

OBJS =
OBJS += $(patsubst %.cpp,$(OBJ_DIR)/%.o,$(filter %.cpp,$(SRCS)))
OBJS += $(patsubst %.cc,$(OBJ_DIR)/%.o,$(filter %.cc,$(SRCS)))
OBJS += $(patsubst %.c,$(OBJ_DIR)/%.o,$(filter %.c,$(SRCS)))
# OBJS += $(SRCS:%.cpp=$(OBJ_DIR)/%.o)
# OBJS += $(CCSRC:%.cc=$(OBJ_DIR)/%.o)
# OBJS += $(CSRC:%.c=$(OBJ_DIR)/%.o)

all: $(BINARY)

# Compilation patterns
# @$(CC) $(CFLAGS) -E -MF /dev/null $< | clang-format > $@.i
$(OBJ_DIR)/%.o: %.c
	@echo + CC $<
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) -c -o $@ $<
	$(call call_fixdep, $(@:.o=.d), $@)

$(OBJ_DIR)/%.o: %.cc
	@echo + CX $<
	@mkdir -p $(dir $@)
	@$(CXX) $(CFLAGS) $(CXXFLAGS) -c -o $@ $<
	$(call call_fixdep, $(@:.o=.d), $@)

$(OBJ_DIR)/%.o: %.cpp
	@echo + CXX $<
	@mkdir -p $(dir $@)
	@$(CXX) $(CFLAGS) $(CXXFLAGS) -c -o $@ $<
	$(call call_fixdep, $(@:.o=.d), $@)

$(VOBJS): $(VSRCS)
	@echo + CV $<
	@mkdir -p $(dir $@)
	@$(VERILATOR) $(VERILATOR_CFLAGS) \
		$(addprefix -CFLAGS , $(VCXXFLAGS)) \
		$(addprefix -LDFLAGS , $(VLDFLAGS)) \
		$^

$(BINARY): $(VOBJS) $(OBJS) $(ARCHIVES)
	@echo + LD $@
	@$(LD) -o $@ $(OBJS) $(LDFLAGS) $(ARCHIVES) $(LIBS)

test: $(BINARY)
	@cd $(NPC_HOME); $(BINARY)

clean:
	rm -rf $(BUILD_DIR)

.PHONY: all clean test
