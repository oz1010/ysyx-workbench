# Rendered by configure.py; run make from this project or make -C <project>.
[tasks]
alu_bmc safety
alu_progress progress
alu_cvr coverage
mem_bmc safety
mem_progress progress
mem_cvr coverage
stall_bmc safety
stall_progress progress
stall_cvr coverage

[options]
safety: mode bmc
safety: depth @DEPTH@
progress: mode bmc
progress: depth @PROGRESS_DEPTH@
coverage: mode cover
coverage: depth @CVR_DEPTH@
# Keep VCD witnesses for failures and coverage. Cover is reachability, not proof.
vcd on

[engines]
smtbmc @SOLVER@

[script]
plugin -i slang
@TASK_SCRIPTS@
prep -top pipelinetest
check -assert

[files]
@FILES@
