# 流水线形式化验证配置，由Makefile从本模板生成verify.sby（替换@NPC_HOME@与@DEPTH@），请勿直接编辑verify.sby
# 工程文件清单参考vsrc/filelist.mk：DUT取流水线核及其依赖（VDIRS_CORE-PIPELINE + common + device/arbiter），
# REF取单周期核（VDIRS_CORE-SINGLE），形式化配置下缓存与外设不编入DUT以压缩BMC求解空间。

[tasks]
bmc
cvr cover

[options]
bmc: mode bmc
bmc: depth @DEPTH@
cvr: mode cover
cvr: depth @CVR_DEPTH@
# 轨迹生成FST格式（sby仿真引擎输出，GTKWave/Surfer原生支持），不再生成VCD
fst on
vcd off

[engines]
# 可选：yices, z3, boolector
# smtbmc @SOLVER@
smtbmc yices
smtbmc boolector

[script]
# 公共RTL读取（不含验证顶层）；验证顶层按任务分别读取：
# bmc带断言；cvr不编译断言（yosys-smtbmc cover模式下求解器模型与witness
# 重放可能出现不一致的伪违例，断言正确性由bmc任务穷举保证，cvr只查覆盖）
read_verilog -formal -sv -DFORMAL_VERIFY -I@NPC_HOME@/vsrc/core/common -I@NPC_HOME@/include \
  @NPC_HOME@/vsrc/core/common/riscv32e_defines.v \
  @NPC_HOME@/vsrc/core/common/gprs.v \
  @NPC_HOME@/vsrc/core/common/csrs.v \
  @NPC_HOME@/vsrc/core/common/stage_regs.v \
  @NPC_HOME@/vsrc/core/common/inner_con.v \
  @NPC_HOME@/vsrc/core/common/axi_master.v \
  @NPC_HOME@/vsrc/core/common/ex_muldivrem.v \
  @NPC_HOME@/vsrc/core/common/perf_monitor.v \
  @NPC_HOME@/vsrc/core/common/hw_monitor.v \
  @NPC_HOME@/vsrc/device/arbiter_axi4.v \
  @NPC_HOME@/vsrc/core/pipeline/inst_fetch.v \
  @NPC_HOME@/vsrc/core/pipeline/inst_decode.v \
  @NPC_HOME@/vsrc/core/pipeline/execute.v \
  @NPC_HOME@/vsrc/core/pipeline/load_store.v \
  @NPC_HOME@/vsrc/core/pipeline/write_back.v \
  @NPC_HOME@/vsrc/core/pipeline/riscv32e_core.v \
  @NPC_HOME@/vsrc/core/pipeline/risk_raw.v \
  @NPC_HOME@/vsrc/core/pipeline/risk_control.v \
  @NPC_HOME@/vsrc/core/pipeline/static_predictor.v \
  @NPC_HOME@/vsrc/core/single/decoder.v \
  @NPC_HOME@/vsrc/core/single/write_back.v \
  @NPC_HOME@/vsrc/core/single/riscv32e_core.v
bmc: read_verilog -formal -sv -DFORMAL_VERIFY -I@NPC_HOME@/vsrc/core/common -I@NPC_HOME@/include @NPC_HOME@/test/verification/verilog/pipelinetest/pipelinetest.sv
bmc: prep -top pipelinetest
cvr: verilog_defaults -add -DFV_CVR_NO_ASSERT
cvr: read_verilog -formal -sv -DFORMAL_VERIFY -I@NPC_HOME@/vsrc/core/common -I@NPC_HOME@/include @NPC_HOME@/test/verification/verilog/pipelinetest/pipelinetest.sv
cvr: prep -top pipelinetest
