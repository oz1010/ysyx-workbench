CONFIG_MROM_SIZE=0x00001000
CONFIG_FLASH=y
CONFIG_FLASH_BASE=0x30000000
CONFIG_FLASH_SIZE=0x01000000
CONFIG_PSRAM=y
CONFIG_PSRAM_BASE=0x80000000
CONFIG_PSRAM_SIZE=0x00400000
CONFIG_SDRAM=y
CONFIG_SDRAM_BASE=0xa0000000
CONFIG_SDRAM_SIZE=0x04000000
