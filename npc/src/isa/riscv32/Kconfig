menu "RISC-V Processor Options"

choice 
    depends on ISA_riscv
    prompt "RISC-V Processor Type"
    default ISA_RISCV_PIPELINE

    config ISA_RISCV_SINGLE
        bool "single"
    config ISA_RISCV_MULTIPLE
        bool "multiple"
    config ISA_RISCV_PIPELINE
        bool "pipeline"
    config ISA_RISCV_PIPELINE_CHISEL
        bool "pipeline-chisel"
endchoice

menu "CSR Initial Values"
  config CSR_MSTATUS_INIT
      hex "Initial value of mstatus"
      default 0xa00001800 if RV64
      default 0x1800
  config CSR_MVENDORID_INIT
      hex "Value of mvendorid (read-only)"
      default 0x78797379
  config CSR_MARCHID_INIT
      hex "Value of marchid (read-only)"
      default 0x15FDF47
endmenu

menuconfig ICACHE
  bool "ICache enable"
  depends on !ISA_RISCV_SINGLE
  default y
  if ICACHE
    config ICACHE_PARAMETER_W
      int "ICache parameter W"
      default 8

    config ICACHE_PARAMETER_N
      int "ICache parameter N"
      default 4

    config ICACHE_PARAMETER_M
      int "ICache parameter M"
      default 4
  endif # ICACHE

menuconfig DCACHE
  bool "DCache enable"
  depends on !ISA_RISCV_SINGLE
  default n
  if DCACHE
    config DCACHE_PARAMETER_W
      int "DCache parameter W"
      default 8

    config DCACHE_PARAMETER_N
      int "DCache parameter N"
      default 4

    config DCACHE_PARAMETER_M
      int "DCache parameter M"
      default 4
  endif # DCACHE

config CHISEL_DIR_NAME
    string "Directory name for Chisel compilation"
    depends on ISA_RISCV_PIPELINE_CHISEL
    default pipeline-manual

config ISA
  string
  default "x86" if ISA_x86
  default "mips32" if ISA_mips32
  default "riscv32" if ISA_riscv && !RV64
  default "riscv64" if ISA_riscv &&  RV64
  default "loongarch32r" if ISA_loongarch32r
  default "none"

config ISA64
  depends on ISA_riscv && RV64
  bool
  default y

config CORE_FREQUENCY
    int "Frequency (Hz) of the core"
    default 97000000

config CORE_NUM
    int "Number of processor cores"
    default 1

config ADDR_WIDTH
    int
    depends on ISA_riscv
    default 64 if RV64
    default 32

config DATA_WIDTH
    int
    depends on ISA_riscv
    default 64 if RV64
    default 32

endmenu
