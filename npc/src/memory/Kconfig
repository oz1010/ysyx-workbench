menu "Memory Configuration"

choice
  prompt "Using memory type"
  default MEM_TYPE_MULTI
config MEM_TYPE_SINGLE
  bool "single"
config MEM_TYPE_MULTI
  bool "multi"
endchoice

if MEM_TYPE_MULTI
menuconfig SRAM
  bool "SRAM memory"
  default y
  if SRAM
    config SRAM_BASE
      hex "SRAM memory base address"
      default 0x0f000000

    config SRAM_SIZE
      hex "SRAM memory size"
      default 0x00002000
  endif # SRAM

menuconfig MROM
  bool "MROM memory"
  default y
  if MROM
    config MROM_BASE
      hex "MROM memory base address"
      default 0x20000000

    config MROM_SIZE
      hex "MROM memory size"
      default 0x00001000
  endif # MROM

menuconfig FLASH
  bool "FLASH memory"
  default y
  if FLASH
    config FLASH_BASE
      hex "FLASH memory base address"
      default 0x30000000

    config FLASH_SIZE
      hex "FLASH memory size"
      default 0x01000000
  endif # FLASH

menuconfig PSRAM
  bool "PSRAM memory"
  default y
  if PSRAM
    config PSRAM_BASE
      hex "PSRAM memory base address"
      default 0x80000000

    config PSRAM_SIZE
      hex "PSRAM memory size"
      default 0x00400000
  endif # PSRAM

menuconfig SDRAM
  bool "SDRAM memory"
  default y
  if SDRAM
    config SDRAM_BASE
      hex "SDRAM memory base address"
      default 0xa0000000

    config SDRAM_SIZE
      hex "SDRAM memory size"
      default 0x04000000

    config SDRAM_FREQUENCY
      int "Frequency (Hz) of the sdram"
      default 167000000
  endif # SDRAM
endif # MEM_TYPE_MULTI

if MEM_TYPE_SINGLE
config MBASE
  hex "Memory base address"
  default 0x0        if ISA_x86
  default 0x0
  
config MSIZE
  hex "Memory size"
  default 0x40000000
endif # end MEM_TYPE_SINGLE

config IMG_LOAD
  hex "Image load address from the base of memory"
  default 0x100000 if ISA_x86
  default MBASE if MEM_TYPE_SINGLE
  default 0x30000000 if MEM_TYPE_MULTI

config FAST_LOAD
  bool "Image load to ram fastly"
  default false if ISA_x86
  default y

choice
  prompt "Physical memory definition"
  default PMEM_MALLOC
config PMEM_MALLOC
  bool "Using malloc()"
config PMEM_GARRAY
  depends on !TARGET_AM
  bool "Using global array"
endchoice

config MEM_INIT_VALUE
  hex "Initialize the memory with specify values"
  default 0x5E
  help
    This may help to find undefined behaviors.

# config MEM_RANDOM
#   depends on MODE_SYSTEM && !DIFFTEST && !TARGET_AM
#   bool "Initialize the memory with random values"
#   default y
#   help
#     This may help to find undefined behaviors.

config DIFF_MSIZE
  hex "Memory size in differential testing"
  depends on DIFFTEST
  default 0x40000000

endmenu #MEMORY
