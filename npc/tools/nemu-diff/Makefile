WORK_DIR    = $(shell pwd)

# Include variables and rules generated by menuconfig
include $(NPC_HOME)/include/config/auto.conf
include $(NPC_HOME)/include/config/auto.conf.cmd

remove_quote = $(patsubst "%",%,$(1))

# Static check
DIFF_REF_PATH = $(NPC_HOME)/$(call remove_quote,$(CONFIG_DIFFTEST_REF_PATH))
DIFF_REF_SO = $(DIFF_REF_PATH)/build/$(GUEST_ISA)-$(call remove_quote,$(CONFIG_DIFFTEST_REF_NAME))-so
DIFF_REF_SO_DST_NAME=$(notdir $(DIFF_REF_SO))
DIFF_REF_SO_SRC_NAME=$(GUEST_ISA)-nemu-$(ENGINE)-so
ifeq ($(wildcard $(DIFF_REF_SO)),)
define NEMU_DIFF_REF_SO_MISSED_MSG
Need to build dynamic library $(DIFF_REF_SO_SRC_NAME) in NEMU
and call follow commands:
    mkdir -p $$NPC_HOME/tools/nemu-diff/{build,include}
    cp $$NEMU_HOME/build/$(DIFF_REF_SO_SRC_NAME) $$NPC_HOME/tools/nemu-diff/build/$(notdir $(DIFF_REF_SO))
    cp $$NEMU_HOME/include/difftest-def.h $$NPC_HOME/tools/nemu-diff/include/
$(DIFF_REF_SO): No such dynamic library
endef
    $(error $(NEMU_DIFF_REF_SO_MISSED_MSG))
endif
