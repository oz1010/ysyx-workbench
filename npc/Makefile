TOPNAME = top
NXDC_FILES = constr/top.nxdc
INC_PATH ?=

VERILATOR = verilator
VERILATOR_CFLAGS += -MMD --build -cc
VERILATOR_CFLAGS += -O3 --x-assign fast --x-initial fast --noassert

BUILD_DIR = $(NPC_HOME)/build
OBJ_DIR = $(BUILD_DIR)/obj_dir
BIN = $(BUILD_DIR)/$(TOPNAME)
TST_TARGET = addi
TST_DIR = $(NPC_HOME)/test/$(TST_TARGET)
TST_BIN = $(BUILD_DIR)/test/$(TST_TARGET)/case.bin
PROG_DIR = $(NPC_HOME)/resource/riscv32-bin
IMG ?= $(NPC_HOME)/build/risc32/prog.bin
RUN_ARGS ?= --log="build/npc-test.log"
RUN_ARGS += -b
DIFFTEST_REF_SO = $(NPC_HOME)/tools/nemu-diff/libs/riscv32-nemu-interpreter-so

# Include variables and rules generated by menuconfig
-include $(NPC_HOME)/include/config/auto.conf

default: check_diff $(BIN) $(TST_BIN) $(IMG)

$(shell mkdir -p $(BUILD_DIR))

# # constraint file
# SRC_AUTO_BIND = $(abspath $(BUILD_DIR)/auto_bind.cpp)
# $(SRC_AUTO_BIND): $(NXDC_FILES)
# 	python3 $(NVBOARD_HOME)/scripts/auto_pin_bind.py $^ $@

# project source
INC_PATH += $(abspath ./include)
INC_PATH += $(NPC_HOME)/../common/include
VSRCS = $(shell find $(abspath ./vsrc) -name "*.v")
# CSRCS = $(shell find $(abspath ./csrc) -name "*.c" -or -name "*.cc" -or -name "*.cpp")
CSRCS = $(shell find $(abspath ./csrc) -name "*.c" -or -name "*.cpp")
CSRCS += $(shell find $(NPC_HOME)/../common/src/dm -name "*.c" -or -name "*.cc" -or -name "*.cpp")
TSTFILES = $(shell find $(abspath $(TST_DIR)) -name "*.S")
# CSRCS += $(SRC_AUTO_BIND)

# # rules for NVBoard
# include $(NVBOARD_HOME)/scripts/nvboard.mk

ifneq ($(CONFIG_ITRACE)$(CONFIG_IQUEUE),)
CSRCS += $(NPC_HOME)/csrc/utils/disasm.cc
# CXXFLAGS += $(shell llvm-config --cxxflags) -fPIE
CXXFLAGS += -I/usr/lib/llvm-14/include -fno-exceptions -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_LIMIT_MACROS -fPIE
# CXXFLAGS += -D__STDC_FORMAT_MACROS
LDFLAGS += $(shell llvm-config --libs)
endif

# open trace with 'make TRACE=1'
ifdef TRACE
VERILATOR_CFLAGS += --trace
#CXXFLAGS += -DTRACE=1
endif

ifneq ($(CONFIG_DIFFTEST),)
INC_PATH += $(NPC_HOME)/tools/nemu-diff/include
RUN_ARGS += --diff="$(DIFFTEST_REF_SO)"
check_diff:
	@if [ ! -f $(DIFFTEST_REF_SO) ]; then \
		echo "Need build dynamic library in NEMU, then call command:"; \
		echo "  mkdir -p $$NPC_HOME/tools/nemu-diff/{libs,include}"; \
		echo '  cp $$NEMU_HOME/build/riscv32-nemu-interpreter-so $$NPC_HOME/tools/nemu-diff/libs/'; \
		echo '  cp $$NEMU_HOME/include/difftest-def.h $$NPC_HOME/tools/nemu-diff/include/'; \
		exit 1; \
	fi
else
check_diff:
	@echo "CONFIG_DIFFTEST not defined, skipping check."
endif

ifneq ($(CONFIG_CC_DEBUG),)
CXXFLAGS += -g
endif

# rules for verilator
INCFLAGS = $(addprefix -I, $(INC_PATH))
# CXXFLAGS += $(INCFLAGS) -DTOP_NAME="\"V$(TOPNAME)\""
CXXFLAGS += $(CONFIG_CC_OPT) $(INCFLAGS) -DTOP_NAME="\"V$(TOPNAME)\""
LDFLAGS += -lreadline

# Include rules for menuconfig
include $(NPC_HOME)/scripts/config.mk

all: check_diff $(BIN) $(TST_BIN) $(IMG)
	@echo start all

# $(BIN): $(VSRCS) $(CSRCS) $(NVBOARD_ARCHIVE)
$(BIN): $(VSRCS) $(CSRCS)
	@echo "CSRCS is $(CSRCS)"
	@rm -rf $(OBJ_DIR)
	$(VERILATOR) $(VERILATOR_CFLAGS) \
		--top-module $(TOPNAME) $^ \
		$(addprefix -CFLAGS , $(CXXFLAGS)) \
		$(addprefix -LDFLAGS , $(LDFLAGS)) \
		--Mdir $(OBJ_DIR) --exe -o $(abspath $(BIN))

$(TST_BIN): $(TSTFILES)
	@make -C $(TST_DIR)

$(IMG):
	@make -C $(PROG_DIR)

run: all
	@$(BIN) $(RUN_ARGS) $(IMG)

objdump: $(TST_BIN)
	@make objdump -C $(TST_DIR)

clean:
	rm -rf $(BUILD_DIR)

.PHONY: default check_diff all clean run objdump



